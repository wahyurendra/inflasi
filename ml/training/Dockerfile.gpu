# CUDA image used only by the TFT Job on k3s-gpu-worker.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libgomp1 gcc g++ \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

COPY ml/training/requirements.txt ml/training/requirements-gpu.txt /tmp/
RUN pip install -r /tmp/requirements.txt -r /tmp/requirements-gpu.txt

COPY ml/training/ /workspace/ml/training/
COPY apps/api-gateway/app/services/feature_encoder.py /workspace/apps/api-gateway/app/services/feature_encoder.py

ENTRYPOINT ["python", "-m"]
CMD ["ml.training.train_tft", "--horizon", "7"]
